{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/C"]
            }
        }
    },
    "tasks": [
        {
            "label": "MSBuild: Debug|x64",
            "type": "shell",
            "command": "\"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\BaseFramework.sln\" /p:Configuration=Debug /p:Platform=x64 /m",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "MSBuild: Debug|Win32",
            "type": "shell",
            "command": "\"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\BaseFramework.sln\" /p:Configuration=Debug /p:Platform=Win32 /m",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "MSBuild: Release|x64",
            "type": "shell",
            "command": "\"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\BaseFramework.sln\" /p:Configuration=Release /p:Platform=x64 /m",
            "group": "build",
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "MSBuild: Clean",
            "type": "shell",
            "command": "\"${env:ProgramFiles(x86)}\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe\" \"${workspaceFolder}\\BaseFramework.sln\" /t:Clean /p:Configuration=Debug /p:Platform=x64",
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}
